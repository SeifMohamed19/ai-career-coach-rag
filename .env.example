# Google Gemini API Key (100% Free at https://aistudio.google.com/ - NO credit card required)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (Free tier options: gemini-1.5-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Embeddings (Default is local CPU sentence-transformers: all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Persistent Vector Store Directory
CHROMA_PERSIST_DIR=./data/chroma_db
